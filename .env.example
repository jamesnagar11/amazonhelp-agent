# ==============================================================================
# AmazonHelp Customer Support AI Agent — Production Environment Template (.env)
# Copy this file to .env and fill in the required API keys and connection secrets.
# ==============================================================================

# ── 1. REQUIRED API KEYS & SECRETS ────────────────────────────────────────────
# OpenRouter API Key (Used for Qwen3 Chat Model & DeepSeek CRAG Judge)
OPEN_ROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# HuggingFace Token (Used for downloading & inference on BAAI/bge-small-en-v1.5 embeddings)
HF_TOKEN=hf_your_huggingface_access_token_here
HUGGINGFACEHUB_ACCESS_TOKEN=hf_your_huggingface_access_token_here

# (Optional) Google AI API Key (If using Gemini models as alternative fallback)
# GOOGLE_API_KEY=your_google_api_key_here

# ── 2. LANGSMITH OBSERVABILITY & TRACING ──────────────────────────────────────
LANGSMITH_TRACING=true
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=amazonhelp

# ── 3. MODEL SELECTION CONFIGURATION ─────────────────────────────────────────
# Chat Model (Qwen3 / DeepSeek / Llama options via OpenRouter)
CHAT_MODEL=qwen/qwen3-8b

# Judge & Evaluator Model (DeepSeek-V3 for intent evaluation & RAGAS metrics)
JUDGE_MODEL=deepseek/deepseek-chat-v3-0324

# Embedding Model (BAAI BGE Small v1.5)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── 4. VECTOR DATABASE (QDRANT CONFIGURATION) ──────────────────────────────────
# For Local Disk or Docker Container:
USE_LOCAL_QDRANT=true
QDRANT_PATH=./qdrant_db
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=amazon_support

# For Qdrant Managed Cloud (Set USE_LOCAL_QDRANT=false when using Qdrant Cloud):
# USE_LOCAL_QDRANT=false
# QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# ── 5. MEMORY & CHECKPOINT DATABASE ──────────────────────────────────────────
SQLITE_PATH=./checkpoints/chat_checkpoints.db
MAX_MESSAGES=10
MAX_TOKENS=3000

# ── 6. PRODUCTION ENVIRONMENT & SERVER ───────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
